# 统一换行符，避免 Windows / macOS 协作时整文件 diff
* text=auto eol=lf

# 中文批处理必须是 CRLF + GBK，交给 Git 处理会把编码搞坏，所以标记为二进制
*.bat -text
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary

# 语言统计里不要把生成物算进去
package-lock.json linguist-generated=true
frontend/package-lock.json linguist-generated=true
