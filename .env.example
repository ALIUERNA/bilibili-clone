# =============================================================================
# 环境变量示例：复制成 .env（已被 .gitignore 忽略，不会提交）
#
# 为什么不用直接写进 application.yml：
#   数据库密码、邮箱 SMTP 授权码属于敏感信息，配置文件会随 git / 镜像分发，
#   明文写进去等于泄露且很难轮换。所以敏感项只放 .env / 系统环境变量，
#   仓库里只保留这份 .env.example。
#
# 加载方式：application.yml 里配置了 spring.config.import=optional:file:./.env[.properties]，
#   启动时若存在 .env 会自动读取；也可以直接设置成系统环境变量。
#   所有变量都有安全默认值，不配也能启动（数据库没起来会先跑内存模式，恢复后自动重连）。
# =============================================================================

# ---------------- MySQL ----------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bili_clone
DB_USER=root
# 本地开发数据库密码（请改成你自己的；生产环境务必用强密码）
DB_PASSWORD=change-me

# ---------------- 上传目录（强烈建议绝对路径） ----------------
# 相对路径会随启动目录变化（项目根 / backend 各有一份 uploads），
# 推荐写绝对路径，例如：
#   Windows: BILI_UPLOAD_DIR=D:/bilibili-clone/uploads
#   Linux:   BILI_UPLOAD_DIR=/app/uploads
BILI_UPLOAD_DIR=

# ---------------- 登录 / 验证码 ----------------
# true  = 开发环境：邮箱验证码打印到控制台，接口里返回 devCode（方便调试 / 自动化验收）
# false = 生产环境：必须配好下面的邮件参数，接口不会返回验证码
BILI_DEV_MODE=true

# 二维码有效期（秒）
# （在 application.yml 里配置：bili.auth.qr-ttl，这里仅作说明）

# 二维码里写入的站点地址；留空则按请求的 Host 自动推断
# 例：局域网手机扫码可以填 http://192.168.1.10:8080
BILI_QR_BASE_URL=

# ---------------- 邮件（只有 BILI_DEV_MODE=false 时才需要） ----------------
# 注意：MAIL_PASSWORD 一般是邮箱的「SMTP 授权码」，不是登录密码，不要提交到仓库
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------- 媒体 / FFmpeg ----------------
# FFmpeg 可执行文件路径；留空则自动查找：PATH 里的 ffmpeg → python 的 imageio-ffmpeg
# Windows 上没装 ffmpeg 时，可以执行：pip install imageio-ffmpeg
FFMPEG_PATH=

# 启动时自动扫描 uploads/videos：绑定真实视频 + FFmpeg 截帧生成封面
# bili.media.auto-scan=true（application.yml 默认开启）

# 没有视频文件时自动生成一批演示视频（约 10 个，每个几十 KB ~ 2MB）
BILI_GENERATE_SAMPLES=true

# ---------------- 服务端口 ----------------
# server.port=8080（application.yml 默认）
